# ──────────────────────────────────────────────
# Candi — Environment Configuration Reference
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── API Keys ──────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here


# ── LLM Provider ──────────────────────────────
# openai  — uses OPENAI_API_KEY (required; default)
# ollama  — experimental: free local models via Ollama's OpenAI-compatible API.
#           Plain chat works; structured-output extraction (resume/JD parsing)
#           still requires OpenAI, so the full prep pipeline needs openai.
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434/v1


# ── Web Search Provider ───────────────────────
# Used by the prep pipeline's research step (company research, interview
# experiences, technical Q&A). The frontend can override this per run.
#
# duckduckgo — free, no key needed; scrapes DuckDuckGo HTML (default)
# tavily     — higher-quality results; 1,000 free credits/month at tavily.com
SEARCH_PROVIDER=duckduckgo
# Required only when Tavily is used
TAVILY_API_KEY=


# ── Sessions ──────────────────────────────────
# How long a session (chat history + prep data) is kept, in days.
# Expired sessions and their vector-store collections are deleted at startup.
SESSION_TTL_DAYS=7


# ── Router Agent ──────────────────────────────
# Handles general chat and quick Q&A from the chat window

# Simple conversational replies (no documents needed)
ROUTER_SIMPLE_CHAT_MODEL=gpt-4o-mini
ROUTER_SIMPLE_CHAT_MAX_TOKENS=500
ROUTER_SIMPLE_CHAT_TEMPERATURE=0.7

# Quick Q&A when resume/JD are present
ROUTER_QUICK_QA_MODEL=gpt-4o-mini
ROUTER_QUICK_QA_MAX_TOKENS=1200
ROUTER_QUICK_QA_TEMPERATURE=0.7


# ── Research Agent ────────────────────────────
# Parses resume and JD; runs web research on the company

# Resume parsing (step 1 of prep pipeline)
RESEARCHER_RESUME_MODEL=gpt-4o-mini
RESEARCHER_RESUME_MAX_TOKENS=1000
RESEARCHER_RESUME_TEMPERATURE=0.3

# Job description parsing (step 2 of prep pipeline)
RESEARCHER_JD_MODEL=gpt-4o-mini
RESEARCHER_JD_MAX_TOKENS=1000
RESEARCHER_JD_TEMPERATURE=0.3

# Company research synthesis (step 3 — summarises web-scraped data)
RESEARCHER_COMPANY_MODEL=gpt-4o-mini
RESEARCHER_COMPANY_MAX_TOKENS=1200
RESEARCHER_COMPANY_TEMPERATURE=0.3


# ── Strategist Agent ──────────────────────────
# Determines interview rounds and preparation strategy

# Predicts likely interview rounds from JD + company research
STRATEGIST_ROUNDS_MODEL=gpt-4o-mini
STRATEGIST_ROUNDS_MAX_TOKENS=1200
STRATEGIST_ROUNDS_TEMPERATURE=0.6

# Assesses candidate seniority vs role requirements
STRATEGIST_SENIORITY_MODEL=gpt-4o-mini
STRATEGIST_SENIORITY_MAX_TOKENS=800
STRATEGIST_SENIORITY_TEMPERATURE=0.5

# Generates personalised week-by-week prep strategy
# Uses gpt-4o by default — downgrade to gpt-4o-mini to save cost
STRATEGIST_STRATEGY_MODEL=gpt-4o
STRATEGIST_STRATEGY_MAX_TOKENS=1500
STRATEGIST_STRATEGY_TEMPERATURE=0.7


# ── Content Gen Agent ─────────────────────────
# Generates all interview questions and answers

# Questions for a single round (used when drilling into one round)
CONTENT_ROUND_QUESTIONS_MODEL=gpt-4o
CONTENT_ROUND_QUESTIONS_MAX_TOKENS=2000
CONTENT_ROUND_QUESTIONS_TEMPERATURE=0.7

# Full question set across all rounds (main prep guide output)
# High max_tokens — reduce if hitting rate limits
CONTENT_ALL_QUESTIONS_MODEL=gpt-4o
CONTENT_ALL_QUESTIONS_MAX_TOKENS=4000
CONTENT_ALL_QUESTIONS_TEMPERATURE=0.7

# Behavioural questions (STAR method)
CONTENT_BEHAVIORAL_MODEL=gpt-4o-mini
CONTENT_BEHAVIORAL_MAX_TOKENS=1500
CONTENT_BEHAVIORAL_TEMPERATURE=0.7

# Technical deep dives with sourced Q&A
# Uses gpt-4o by default for accuracy — lower temperature keeps answers precise
CONTENT_TECHNICAL_MODEL=gpt-4o
CONTENT_TECHNICAL_MAX_TOKENS=3000
CONTENT_TECHNICAL_TEMPERATURE=0.5
